# Supabase (podstawowy klucze dla frontendu - nie umieszczaj tutaj kluczy serwisowych!)
NEXT_PUBLIC_SUPABASE_URL=https://two-steps-studio.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (nie umieszczaj kluczy w repozytorium!)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord Bot (konfiguruj w osobnym .env dla botu)
# DISCORD_TOKEN=your-discord-token
# CLIENT_ID=your-discord-client-id
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security
# Ustaw odpowiednie uprawnienia plików .env (chmod 600)
# Nie commituj plików .env do repozytorium
