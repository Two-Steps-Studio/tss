# Environment variables for Warzone Analyzer

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Storage (Service Key)
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=

# CV Service
CV_MODEL_DIR=./models
CV_MAX_VIDEO_SIZE=1073741824
CV_FPS_THRESHOLD=60
CV_BATCH_SIZE=4

# Model registry
CV_MODEL_REGISTRY_URL=http://localhost:8080
CV_TRAINING_DATA_BUCKET=warzone-training-data
